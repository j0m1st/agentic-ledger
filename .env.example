# Optional: secrets as env vars instead of the OS keychain (CI, or `op run --env-file=.env.example` with op:// refs).
# Pattern: AL_<BOOK>_<KEY>. Never commit real values.
# AL_ACME_QBO_CLIENT_ID=op://Private/acme-qbo/client_id
# AL_ACME_QBO_CLIENT_SECRET=op://Private/acme-qbo/client_secret
# AL_ACME_QBO_REFRESH_TOKEN=op://Private/acme-qbo/refresh_token   # rotates; keychain is better for QBO
# AL_ACME_QBO_REALM_ID=
# AL_ACME_XERO_CLIENT_ID=
# AL_ACME_XERO_CLIENT_SECRET=
# AL_ACME_INTACCT_CLIENT_ID=
# AL_ACME_INTACCT_CLIENT_SECRET=
# AL_ACME_INTACCT_USER=
# AL_ACME_NS_CLIENT_ID=
# AL_ACME_NS_CERTIFICATE_ID=
# AL_ACME_NS_PRIVATE_KEY=
# AL_ACME_RESEND_API_KEY=
